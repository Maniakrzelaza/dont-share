# Serwer plików wewnątrz kontenera web. Certyfikaty i nagłówki bezpieczeństwa są na brzegu
# (deploy/Caddyfile) — tutaj tylko HTTP w sieci kontenerów.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# index.html zmienia się z każdym wydaniem, więc przeglądarka ma go sprawdzać za każdym razem.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# index.html jest szablonem: wybiera polskie albo angielskie tagi OG według ?lang=en, bo roboty
	# podglądu linków nie uruchamiają JavaScriptu. Tylko ten plik — skrypty zostają nietknięte.
	templates @html

	file_server
}
